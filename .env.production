# Baked into the static build by `npm run build` (NEXT_PUBLIC_* only).
# PUBLIC VALUES ONLY: everything here ends up in visitors' browsers.
# Never put a secret (sk_...) key or a password in this file.

NEXT_PUBLIC_SITE_URL=https://www.nlbs.com.ng

# Central backend. The NLBS public key is safe to publish: the backend only
# accepts it from https://www.nlbs.com.ng and https://nlbs.com.ng, rate-limited.
# After `php artisan central:rotate-key nlbs --public`, update it here and rebuild.
NEXT_PUBLIC_CENTRAL_API_URL=https://api.nlbs.com.ng
NEXT_PUBLIC_CENTRAL_SITE_KEY=pk_7Ktw749XuGa20AJLlo8bIHKH90bqCtyH
