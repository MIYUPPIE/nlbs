# Nigeria 2.0 static site on cPanel (public_html). Generated by the Next.js
# static export; scripts/build-cpanel.sh ships this file with the build.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Generated images are written without an extension (/icon, /opengraph-image).
<FilesMatch "^(icon|apple-icon|opengraph-image)$">
  ForceType image/png
</FilesMatch>
AddType application/manifest+json .webmanifest
AddType text/plain .txt

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One canonical host over HTTPS: https://www.nlbs.com.ng
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^nlbs\.com\.ng$ [NC]
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteRule ^ https://www.nlbs.com.ng%{REQUEST_URI} [R=301,L]

  # Friendly aliases for the Talent Fund portal printed in the FAQ and 2.md.
  RewriteRule ^talent/apply/?$ /talentnigeria20/ [R=301,L]
  RewriteRule ^apply/?$ /talentnigeria20/ [R=302,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Unlisted partner form: kept out of search results and caches.
  <If "%{REQUEST_URI} =~ m#^/sponsors(/|$)#">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set Cache-Control "private, no-store"
  </If>

  # Hashed build assets never change: cache for a year. Pages revalidate.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#(\.html|/)$#">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </ElseIf>
</IfModule>
