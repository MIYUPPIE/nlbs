# The site is a static export (npm run build -> out/). Only NEXT_PUBLIC_*
# values exist, baked in at build time. Production values: .env.production.
# For local dev, copy to .env.local.

# Canonical origin used for metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.nlbs.com.ng

# Central backend that receives every form (central-backend repo).
# Without these, forms say "not open yet" instead of sending.
NEXT_PUBLIC_CENTRAL_API_URL=
NEXT_PUBLIC_CENTRAL_SITE_KEY=

# Talent Fund window is 1-30 Oct 2026 (Lagos), also enforced by the backend.
# "open" or "closed" forces the page's state at build time.
# NEXT_PUBLIC_TALENT_APPLICATIONS_OVERRIDE=
