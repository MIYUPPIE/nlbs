# Canonical origin used for metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.nlbs.com.ng

# Registration delivery. Without a webhook, production returns 503 (no fake confirmations).
REGISTRATION_WEBHOOK_URL=
REGISTRATION_WEBHOOK_SECRET=
# REGISTRATION_ALLOW_UNCONNECTED=true   # demo/staging only

# Enquiry (contact form) delivery.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=
# ENQUIRY_ALLOW_UNCONNECTED=true

# Talent Fund application (/talentnigeria20). Payload includes a base64 PDF CV
# (up to 2 MB) and a `screening` object for reviewers.
TALENT_WEBHOOK_URL=
TALENT_WEBHOOK_SECRET=
# TALENT_ALLOW_UNCONNECTED=true
# Window is 1-30 Oct 2026 (Lagos). Force with "open" or "closed" to open early or extend.
# TALENT_APPLICATIONS_OVERRIDE=

# Partner form at /sponsors (unlisted: no link on the site, not indexed).
SPONSOR_WEBHOOK_URL=
SPONSOR_WEBHOOK_SECRET=
# SPONSOR_ALLOW_UNCONNECTED=true
